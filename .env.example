# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase
# (Supabase Dashboard → Project Settings → API Keys / Data API)
# ถ้าเว้นว่าง เกมจะใช้โหมดทดสอบ เล่นได้เฉพาะหลายแท็บในเบราว์เซอร์เดียว
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ใส่ 1 เพื่อใช้เพลงปลอม (เสียงสังเคราะห์) ทดสอบแบบไม่ต้องต่อ Apple
MOCK_MUSIC=

# (ไม่บังคับ) โหมด Spotify playlist: Client ID จาก developer.spotify.com
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# (ไม่บังคับ) โหมด YouTube playlist: API key ของ YouTube Data API v3
YOUTUBE_API_KEY=
